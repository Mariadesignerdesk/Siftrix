# Siftrix Environment Configuration

# Server & Application Settings
PROJECT_NAME="Siftrix API"
DEBUG=True

# CORS Configuration (Vite frontend)
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL Database (Local and Railway)
# Format: postgresql+psycopg://username:password@localhost:5432/siftrix
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/siftrix

# External APIs (Fill in your local .env file; do not commit keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30.0

VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT=10.0

# Runtime environment
ENVIRONMENT=development

# JWT signing secret (leave blank for local development)
JWT_SECRET_KEY=
